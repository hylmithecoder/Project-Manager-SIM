{
  "name": "nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run server/dev.ts",
    "dev:next": "next dev",
    "dev:server": "bun --watch run server/index.ts",
    "build": "next build",
    "build:web": "STATIC_EXPORT=true next build",
    "build:embed": "bun run server/scripts/embed-static.ts",
    "build:bin": "STATIC_EXPORT=true next build && bun run server/scripts/embed-static.ts && mkdir -p build && bun build --compile --minify --bytecode server/index.ts --outfile build/projectmanager",
    "start": "next start",
    "start:bin": "./build/projectmanager",
    "lint": "eslint",
    "server": "bun run server/index.ts",
    "server:dev": "bun --watch run server/index.ts",
    "db:setup": "bun run server/database/scheme.ts",
    "db:seed": "bun run server/database/seeder.ts",
    "test": "bun test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
